generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  recruiter
  admin
}

enum AccountStatus {
  active
  suspended
}

enum CompanyVerificationStatus {
  pending
  verified
  rejected
  suspended
}

enum InternshipModerationStatus {
  active
  flagged
  removed
}

enum AuditOutcome {
  success
  failed
}

enum MatchingRunStatus {
  success
  failed
}

enum WorkMode {
  remote
  hybrid
  onsite
}

enum InternshipStatus {
  draft
  open
  closed
}

enum ApplicationStatus {
  Applied
  Interview
  Offer
  Rejected
}

enum NotificationType {
  application_submitted
  application_status_updated
  system
}

enum CVParseStatus {
  uploaded
  parsed
  failed
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         UserRole
  status       AccountStatus  @default(active)
  displayName  String?
  lastActiveAt DateTime?
  suspendedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  student      StudentProfile?
  recruiter    Recruiter?
  auditLogs    AuditLog[]     @relation("AuditActor")
  companyReviews Company[]    @relation("CompanyReviewer")
  moderatedInternships Internship[] @relation("InternshipModerator")
}

model StudentProfile {
  id                 String                @id @default(uuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  degreeProgram      String
  semester           Int
  locationPreference String?
  industryPreference String?
  availability       DateTime?
  cvUrl              String?
  cvSummary          String?
  avatarUrl          String?
  cvDocuments        CVDocument[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  skills             StudentSkill[]
  projects           Project[]
  applications       Application[]
  recommendations    MatchRecommendation[]
  notifications      Notification[]
}

model Company {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  industry           String?
  location           String?
  description        String?
  website            String?
  careerPage         String?
  logoUrl            String?
  verificationStatus CompanyVerificationStatus @default(pending)
  verificationNotes  String?
  rejectionReason    String?
  reviewedById       String?
  reviewedBy         User?        @relation("CompanyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  recruiters         Recruiter[]
  internships        Internship[]
  analytics          AdminAnalytics[]
}

model Recruiter {
  id            String         @id @default(uuid())
  userId        String         @unique
  companyId     String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  role          String?
  notifications Notification[]
}

model CVDocument {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  mimeType      String
  sizeBytes     Int
  parsedText    String?
  parsedData    Json?
  parseStatus   CVParseStatus  @default(uploaded)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Skill {
  id                       String                       @id @default(uuid())
  name                     String                       @unique
  category                 String
  studentSkills            StudentSkill[]
  internshipRequirements   InternshipSkillRequirement[]
}

model StudentSkill {
  id              String         @id @default(uuid())
  studentId       String
  skillId         String
  proficiency     Int
  yearsExperience Float?
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill           Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
}

model Project {
  id               String         @id @default(uuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  technologiesUsed String?
  startDate        DateTime?
  endDate          DateTime?
}

model Internship {
  id              String                       @id @default(uuid())
  companyId       String
  company         Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String
  location        String?
  workMode        WorkMode
  duration        String?
  salaryRange     String?
  postedDate      DateTime                     @default(now())
  deadline        DateTime
  status          InternshipStatus             @default(open)
  duplicateKey    String?
  moderationStatus InternshipModerationStatus @default(active)
  moderationReason String?
  moderatedById    String?
  moderatedBy      User?        @relation("InternshipModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  sources         InternshipSource[]
  requirements    InternshipSkillRequirement[]
  applications    Application[]
  recommendations MatchRecommendation[]
}

model InternshipSource {
  id                String     @id @default(uuid())
  internshipId      String
  internship        Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  platformName      String
  sourceUrl         String
  sourceType        String
  collectedAt       DateTime   @default(now())
  lastCheckedAt     DateTime   @default(now())
  isActive          Boolean    @default(true)
  externalPostingId String?
  duplicateGroup    String?

  @@unique([platformName, externalPostingId])
  @@unique([platformName, sourceUrl])
}

model InternshipSkillRequirement {
  id            String     @id @default(uuid())
  internshipId  String
  skillId       String
  requiredLevel Int
  weight        Float
  internship    Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill         Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([internshipId, skillId])
}

model MatchRecommendation {
  id           String         @id @default(uuid())
  studentId    String
  internshipId String
  matchScore   Float
  explanation  String
  createdAt    DateTime       @default(now())
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship   Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
}

model Application {
  id              String              @id @default(uuid())
  studentId       String
  internshipId    String
  applicationDate DateTime            @default(now())
  status          ApplicationStatus   @default(Applied)
  recruiterNotes  String?
  updatedAt       DateTime            @updatedAt
  student         StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship      Internship          @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@unique([studentId, internshipId])
}

model Notification {
  id            String            @id @default(uuid())
  studentId     String?
  recruiterId   String?
  applicationId String?
  student       StudentProfile?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recruiter     Recruiter?        @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  application   Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  message       String
  type          NotificationType
  isRead        Boolean           @default(false)
  createdAt     DateTime          @default(now())
}

model AdminAnalytics {
  id                 String    @id @default(uuid())
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  capturedAt         DateTime  @default(now())
  totalStudents      Int       @default(0)
  totalRecruiters    Int       @default(0)
  totalInternships   Int       @default(0)
  totalApplications  Int       @default(0)
  totalNotifications Int       @default(0)
  topIndustry        String?
  topLocation        String?
}

model AuditLog {
  id         String       @id @default(uuid())
  actorId    String
  actor      User         @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  outcome    AuditOutcome @default(success)
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model MatchingRun {
  id               String            @id @default(uuid())
  status           MatchingRunStatus
  provider         String
  algorithmVersion String
  jobsProcessed    Int               @default(0)
  durationMs       Int?
  errorCode        String?
  createdAt        DateTime          @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}
